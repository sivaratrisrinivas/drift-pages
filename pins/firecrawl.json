            "video": {
              "kind": "PER_UNIT",
              "unit": "PAGE",
              "every": 1,
              "consumes": {
                "credit": "default",
                "amount": 4
              },
              "label": "video extraction",
              "description": "video extraction on every scraped page"
            },
            "redact_pii": {
              "kind": "PER_UNIT",
              "unit": "PAGE",
              "every": 1,
              "consumes": {
                "credit": "default",
                "amount": 4
              },
              "label": "PII redaction",
              "description": "redaction on every scraped page"
            },
            "prompt_injection_check": {
              "kind": "PER_UNIT",
              "unit": "PAGE",
              "every": 1,
              "consumes": {
                "credit": "default",
                "amount": 4
              },
              "label": "prompt-injection check",
              "description": "the `checkPromptInjection` guard on every scraped page"
            },
            "lockdown": {
              "kind": "PER_UNIT",
              "unit": "PAGE",
              "every": 1,
              "consumes": {
                "credit": "default",
                "amount": 4
              },
              "label": "lockdown cache read",
              "description": "cache-only serving on every scraped page"
            },
            "zero_data_retention": {
              "kind": "PER_UNIT",
              "unit": "PAGE",
              "every": 1,
              "consumes": {
                "credit": "default",
                "amount": 1
              },
              "label": "zero data retention",
              "description": "no page content persisted beyond the batch"
            },
            "threat_protection_scan": {
              "kind": "PER_UNIT",
              "unit": "PAGE",
              "every": 1,
              "consumes": {
                "credit": "default",
                "amount": 2
              },
              "label": "threat-protection scan",
              "description": "URL risk scan requested via `threatProtection.mode: normal`"
            },
            "x_routing": {
              "kind": "PER_UNIT",
              "unit": "PAGE",
              "every": 1,
              "consumes": {
                "credit": "default",
                "amount": 29
