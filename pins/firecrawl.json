            "highlights": {
              "kind": "PER_UNIT",
              "unit": "PAGE",
              "every": 1,
              "consumes": {
                "credit": "default",
                "amount": 4
              },
              "label": "highlights",
              "description": "LLM passage selection on every scraped page"
